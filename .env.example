# Copy this file to .env and replace the placeholder with your Gemini API key.
# Never commit .env or a real API key.
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Optional engine settings. Defaults are shown.
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_MAX_OUTPUT_TOKENS=4096
# GEMINI_THINKING_LEVEL=medium
# GEMINI_TIMEOUT_MS=30000
# LEGAL_CORPUS_PATH=research_and_data/legal_corpus.jsonl
# LEGAL_RETRIEVAL_LIMIT=5
# LEGAL_MINIMUM_RELEVANCE=0.25

# Optional API settings. CORS is disabled unless explicit origins are listed.
# API_ALLOWED_ORIGINS=http://localhost:3000,https://assistant.example
# API_MAX_REQUEST_BYTES=16384
# API_RATE_LIMIT_REQUESTS=60
# API_RATE_LIMIT_WINDOW_SECONDS=60
